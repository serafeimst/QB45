        bIndex = fs(face, 1)
        cIndex = fs(face, 2)

        ax = vs(aIndex).x
        ay = vs(aIndex).y
        az = vs(aIndex).z

        bx = vs(bIndex).x
        by = vs(bIndex).y
        bz = vs(bIndex).z

        cx = vs(cIndex).x
        cy = vs(cIndex).y
        cz = vs(cIndex).z

            '-----------------------
            ' Rotate XZ
            '-----------------------

            c = COS(angle)
            s = SIN(angle)

            xa = ax * c - az * s
            za = ax * s + az * c

            xb = bx * c - bz * s
            zb = bx * s + bz * c

            '-----------------------
            ' Translate Z
            '-----------------------

            za = za + 1
            zb = zb + 1

            '-----------------------
            ' Project
            '-----------------------

            p1x = xa / za
            p1y = ay / za

            p2x = xb / zb
            p2y = by / zb

            '-----------------------
            ' Screen
            '-----------------------

            s1x = (p1x + 1) / 2 * 320
            s1y = (1 - (p1y + 1) / 2) * 200

            s2x = (p2x + 1) / 2 * 320
            s2y = (1 - (p2y + 1) / 2) * 200

            '-----------------------
            ' Draw
            '-----------------------

            LINE (s1x, s1y)-(s2x, s2y), 2

    NEXT face

    angle = angle + .01

    SWAP active, visible
